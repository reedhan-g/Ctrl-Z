{
  "name": "ctrl-z",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config config/vite.config.ts --host 127.0.0.1",
    "build": "tsc -b config/tsconfig.json && vite build --config config/vite.config.ts",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview --config config/vite.config.ts --host 127.0.0.1",
    "test:browser": "playwright test --config config/playwright.config.ts",
    "test:embarko": "npm run build -- --mode embarko && playwright test --config config/embarko/playwright.embarko.config.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "pixi.js": "^8.0.0",
    "zustand": "^5.0.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
